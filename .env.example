# Option A: Direct Ollama connection (no Vault)
OLLAMA_API_KEY=your-api-key-or-nothing-for-local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option B: Vault-backed secrets (requires Vault server)
# VAULT_ADDRESS=http://127.0.0.1:8200
# VAULT_ROLE_ID=your-approle-role-id
# VAULT_SECRET_ID=your-approle-secret-id

# Vault KV mount path (optional, default: "secrets")
# VAULT_KV_MOUNT=secrets
# VAULT_SECRET_PATH=rust-agent